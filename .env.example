# 访问模式：有已备案域名使用 domain；否则使用 ip
ACCESS_MODE=ip
PUBLIC_IP=
APP_DOMAIN=
# 基础镜像仓库前缀，可填 docker.io 或云厂商镜像仓库前缀
REGISTRY_PREFIX=docker.io
NPM_REGISTRY=https://registry.npmmirror.com
NODE_GYP_MIRROR=https://npmmirror.com/mirrors/node
APP_PASSWORD_HASH=
# Optional multi-account login. Store base64-encoded bcrypt hashes only; keep this out of Git.
APP_USERS_JSON=
# Optional explicit pair configuration for the Together feature, e.g. [["alice","bob"]].
TOGETHER_PAIRS_JSON=
SESSION_SECRET=
COOKIE_SECURE=true
TIMEZONE=Asia/Shanghai
DAY_START_HOUR=4
DATABASE_PATH=/app/data/growth.db
# OpenAI 兼容 AI 配置，M5 启用
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_USER_AGENT=growth-os/0.1.0
AI_SEND_SESSION_HEADER=true
AI_TIMEOUT_MS=90000
AI_MODEL_WEEKLY=
AI_EXTRA_HEADERS=
